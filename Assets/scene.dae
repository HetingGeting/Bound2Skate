        <effect id="Effect-Default" name="Default">
            <profile_COMMON>
                <technique sid="common">
                    <phong>
                        <diffuse>
                            <color sid="diffuse_effect_rgb">1 1 1 1</color>
                        </diffuse>
                        <specular>
                            <color sid="specular_effect_rgb">1 1 1 1</color>
                        </specular>
