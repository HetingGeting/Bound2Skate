        <effect id="Effect-Material_Concrete_Deck_01" name="Material_Concrete_Deck_01">
            <profile_COMMON>
                <newparam sid="Image0005-surface">
                    <surface type="2D">
                        <init_from>Image0005</init_from>
                        <format>A8R8G8B8</format>
                    </surface>
                </newparam>
                <newparam sid="Image0005-sampler">
                    <sampler2D>
                        <source>Image0005-surface</source>
                        <minfilter>LINEAR_MIPMAP_LINEAR</minfilter>
                        <magfilter>LINEAR</magfilter>
                    </sampler2D>
                </newparam>
                <technique sid="common">
                    <phong>
                        <diffuse>
                            <texture texture="Image0005-sampler" texcoord="Texture" />
                        </diffuse>
                        <specular>
                            <color sid="specular_effect_rgb">0.00393141 0.00393141 0.00393141 1</color>
                        </specular>
                        <shininess>
                            <float sid="specular_effect_rgb">64</float>
                        </shininess>
                        <reflective>
                            <color sid="reflective_effect_rgb">0.788251 0.788251 0.788251 1</color>
                        </reflective>
                        <reflectivity>
                            <float sid="reflectivity_effect_float">0.005</float>
                        </reflectivity>
                    </phong>
                </technique>
            </profile_COMMON>
        </effect>
